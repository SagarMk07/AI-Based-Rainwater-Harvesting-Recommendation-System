# =====================================================================
# AI-BASED RAINWATER HARVESTING INTELLIGENCE & OPTIMIZATION SYSTEM
# Environment Configuration Template (Production Hardened)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Backend Application Settings
# ---------------------------------------------------------------------
APP_NAME="AI Rainwater Harvesting Intelligence & Optimization System"
APP_ENV=development                # Options: development, testing, production
DEBUG=false                        # Set false in production
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------
# 2. CORS Origins (Comma-separated list of allowed web domains)
# In production, specify exact domain (e.g. https://rainharvester.app)
# Do NOT use wildcard '*' for production deployments
# ---------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ---------------------------------------------------------------------
# 3. Security, Payload, & Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=1000000     # 1 MB maximum JSON payload

# ---------------------------------------------------------------------
# 4. Supabase & Database Configuration (Optional for offline guest mode)
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-cryptographic-verification
DATABASE_URL=postgresql://postgres:password@localhost:5432/rainwater_db

# ---------------------------------------------------------------------
# 5. ML Model Directories
# ---------------------------------------------------------------------
MODEL_DIR=ml/models
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ---------------------------------------------------------------------
# 6. Optional External APIs (Offline IMD & ERA5 reanalysis work without key)
# ---------------------------------------------------------------------
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------
# 7. Frontend Environment Variables (Prefix with VITE_)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
