# =====================================================================
# AI-BASED RAINWATER HARVESTING INTELLIGENCE & OPTIMIZATION SYSTEM
# Environment Configuration Template
# =====================================================================

# Application Configuration
APP_NAME="AI Rainwater Harvesting Intelligence & Optimization System"
APP_ENV=development
DEBUG=true
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Supabase Database Configuration (Optional for offline/guest analysis)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/rainwater_db

# ML & Model Pipeline Settings
MODEL_DIR=ml/models
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Optional Weather API (System works offline with local datasets by default)
OPENWEATHER_API_KEY=
